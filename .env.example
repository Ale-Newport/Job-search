# Meridian reads no .env file by itself: these are the environment variables the backend and scripts understand.
# Export the ones you need in your shell (or copy this file to .env and `set -a; source .env; set +a`).
# Never put API keys or passwords here: Meridian stores provider keys, OAuth tokens and app passwords in macOS Keychain.

# Development mode: a fixed local API token so `make dev-web` can talk to `make backend`. Loopback only; never for a
# shared or network-facing deployment. scripts/dev_backend.sh sets it for you.
MERIDIAN_DEV=0

# Where Meridian keeps its SQLite database, documents, browser profiles and logs.
# Default: ~/Library/Application Support/Meridian (development scripts use ./.local-data).
MERIDIAN_DATA_DIR=

# Browser-assistant bridge for the Chrome/Safari extension. 0 disables it (useful when the installed app is also running).
MERIDIAN_BRIDGE=1
# Port or LOW-HIGH range for the bridge. The shipped extension only looks at 47615-47624, so leave empty normally.
MERIDIAN_BRIDGE_PORT=

# Suppress macOS notifications and approval dialogs (tests set MERIDIAN_TEST=1, which implies this).
MERIDIAN_NO_NOTIFICATIONS=0

# Test mode: synthetic data, no real notifications or local model engines. Set by `make test`; do not use for real data.
MERIDIAN_TEST=
