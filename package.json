{
  "name": "meridian-desktop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "build": ".venv/bin/python scripts/build_signed_app.py",
    "build:app": ".venv/bin/python scripts/build_signed_app.py --bundles app",
    "build:extension": ".venv/bin/python scripts/build_extension.py",
    "build:safari": ".venv/bin/python scripts/build_extension.py --safari",
    "typecheck": "npm --prefix frontend run typecheck && npm --prefix extension run typecheck",
    "typecheck:extension": ".venv/bin/python scripts/build_extension.py --typecheck-only",
    "test:extension": "npm --prefix extension test",
    "lint": "npm --prefix frontend run lint"
  },
  "devDependencies": {"@tauri-apps/cli": "^2.0.0"}
}
